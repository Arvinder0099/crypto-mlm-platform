# ============================================
# Hexanova Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==================== REQUIRED ====================

# JWT Secret - MUST be a strong random string (min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/crypto-mlm

# ==================== ADMIN ====================

# Admin account credentials (set on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# ==================== CORS ====================

# Comma-separated allowed origins (defaults: https://hexanova.net,https://www.hexanova.net)
ALLOWED_ORIGINS=https://hexanova.net,https://www.hexanova.net

# ==================== EMAIL ====================

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==================== SMS / OTP ====================

SMS_PROVIDER=msg91
MSG91_API_KEY=
# OR for Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ==================== DEPLOYMENT ====================

NODE_ENV=production
PORT=3040
REACT_APP_API_URL=
